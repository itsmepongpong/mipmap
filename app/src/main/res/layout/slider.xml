<?xml version="1.0" encoding="utf-8"?>
<!--
    The slider layer, on its own. It only knows how to slide a panel in
    from the right over a dimmed background - it has no idea what's
    underneath it (map, buildings, whatever). Included into other screens
    with <include layout="@layout/slayder" />.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dimmed background shown behind the panel -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />


    <LinearLayout
        android:id="@+id/buildingPanel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:padding="20dp">

        <TextView
            android:id="@+id/panelBuildingName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Building"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:layout_width="194dp"
            android:layout_height="wrap_content"
            android:id="@+id/reservation_btn"
            android:background="@color/white"
            android:text="Reserve"
            android:textColor="@color/black"/>

        <Button
            android:id="@+id/btn_close_panel"
            android:layout_width="194dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/white"
            android:text="Settings"
            android:textColor="@color/black"/>

    </LinearLayout>

</FrameLayout>